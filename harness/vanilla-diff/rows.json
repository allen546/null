  "A17:disconnect_on_scale": {
    "skip": "Null refuses on purpose: after the Scale attribute the fork closes the connection before the next position (patch 30), and the vanilla client would not disconnect. The row's only input is the idle spare account."
  },
  "A17:disconnect_on_ride": {
    "skip": "Null refuses on purpose: after the boat mount the fork closes the connection (patch 30); the vanilla client would ride. The row's only input is the idle spare account."
  },
  "A17:disconnect_in_bubble_column": {
    "skip": "Null refuses on purpose: in a bubble column the fork closes the connection (patch 30); the vanilla client would be pushed. The row's only input is the idle spare account."
  },
