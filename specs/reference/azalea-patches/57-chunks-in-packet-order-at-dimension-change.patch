diff --git a/azalea-client/src/plugins/chunks.rs b/azalea-client/src/plugins/chunks.rs
index 7f5a5d3..24c5e72 100644
--- a/azalea-client/src/plugins/chunks.rs
+++ b/azalea-client/src/plugins/chunks.rs
@@ -47,6 +47,12 @@ impl Plugin for ChunksPlugin {
 pub struct ReceiveChunkEvent {
     pub entity: Entity,
     pub packet: ClientboundLevelChunkWithLight,
+    /// The world the bot held when the packet arrived. A respawn into another dimension swaps
+    /// it, and a chunk of the old level must not be decoded into the new one.
+    ///
+    /// Weak, so a queued event does not keep a dropped level alive (that would make a later
+    /// respawn into a same-named dimension find the old level).
+    pub world: std::sync::Weak<parking_lot::RwLock<azalea_world::World>>,
 }
 
 #[derive(Clone, Component, Debug)]
@@ -75,6 +81,14 @@ pub fn handle_receive_chunk_event(
         let pos = ChunkPos::new(event.packet.x, event.packet.z);
 
         let (local_player, mut prediction) = query.get_mut(event.entity).unwrap();
+        // `ClientPacketListener` handles a chunk packet in packet order, against the level of
+        // that moment; a later respawn builds a new level. A chunk of a level the bot has left
+        // is dropped, as vanilla's write into the old level is lost with it.
+        // Spec: specs/F5-version-layer.md §4.6 (What Null computes)
+        if !std::sync::Weak::ptr_eq(&event.world, &std::sync::Arc::downgrade(&local_player.shared)) {
+            trace!("Dropping chunk {pos:?} of a level the bot has left");
+            continue;
+        }
         // `ClientPacketListener#updateLevelChunk`: the packet's blocks win over a pending
         // prediction; the retained state stays for the ack.
         // Spec: specs/B6-placement-breaking.md §4.10
diff --git a/azalea-client/src/plugins/packet/game/mod.rs b/azalea-client/src/plugins/packet/game/mod.rs
index 2e7bc77..b64f2e3 100644
--- a/azalea-client/src/plugins/packet/game/mod.rs
+++ b/azalea-client/src/plugins/packet/game/mod.rs
@@ -633,13 +633,17 @@ impl GamePacketHandler<'_> {
         // debug!("Got light update packet {p:?}");
     }
 
+    // Spec: specs/F5-version-layer.md §4.6 (What Null computes)
     pub fn level_chunk_with_light(&mut self, p: &ClientboundLevelChunkWithLight) {
         debug!("Got chunk with light packet {} {}", p.x, p.z);
 
-        as_system::<MessageWriter<_>>(self.ecs, |mut events| {
+        as_system::<(MessageWriter<_>, Query<&WorldHolder>)>(self.ecs, |(mut events, holders)| {
+            // No world yet (before the login packet): nothing to decode into, as in vanilla.
+            let Ok(holder) = holders.get(self.player) else { return };
             events.write(chunks::ReceiveChunkEvent {
                 entity: self.player,
                 packet: p.clone(),
+                world: Arc::downgrade(&holder.shared),
             });
         });
     }
diff --git a/azalea-client/tests/simulation/chunks_in_packet_order_at_dimension_change.rs b/azalea-client/tests/simulation/chunks_in_packet_order_at_dimension_change.rs
new file mode 100644
index 0000000..ae15081
--- /dev/null
+++ b/azalea-client/tests/simulation/chunks_in_packet_order_at_dimension_change.rs
@@ -0,0 +1,68 @@
+//! A chunk packet that arrives before a respawn into another dimension belongs to the old level
+//! (`ClientPacketListener#handleLevelChunkWithLight` runs in packet order, `#handleRespawn` then
+//! builds a new level). Null must not decode it against the new level.
+// Spec: specs/F5-version-layer.md §4.6 (What Null computes)
+
+use azalea_client::test_utils::prelude::*;
+use azalea_core::position::ChunkPos;
+use azalea_protocol::packets::{ConnectionProtocol, config::{ClientboundFinishConfiguration, ClientboundRegistryData}};
+use azalea_registry::{DataRegistry, data::DimensionKind, identifier::Identifier};
+use simdnbt::owned::{NbtCompound, NbtTag};
+
+fn start() -> Simulation {
+    let mut simulation = Simulation::new(ConnectionProtocol::Configuration);
+    simulation.receive_packet(ClientboundRegistryData {
+        registry_id: Identifier::new("minecraft:dimension_type"),
+        entries: vec![
+            (Identifier::new("azalea:fakedimension"), Some(NbtCompound::from_values(vec![
+                ("height".into(), NbtTag::Int(16)), ("min_y".into(), NbtTag::Int(0))]))),
+            (Identifier::new("minecraft:overworld"), Some(NbtCompound::from_values(vec![
+                ("height".into(), NbtTag::Int(384)), ("min_y".into(), NbtTag::Int(-64))]))),
+            (Identifier::new("minecraft:nether"), Some(NbtCompound::from_values(vec![
+                ("height".into(), NbtTag::Int(256)), ("min_y".into(), NbtTag::Int(0))]))),
+        ]
+        .into_iter()
+        .collect(),
+    });
+    simulation.tick();
+    simulation.receive_packet(ClientboundFinishConfiguration);
+    simulation.tick();
+    simulation
+}
+
+const OVERWORLD_SECTIONS: usize = (384 + 64) / 16;
+const NETHER_SECTIONS: usize = 256 / 16;
+
+#[test]
+fn old_level_chunk_queued_before_a_respawn_is_not_decoded_into_the_new_level() {
+    let _lock = init();
+    let mut simulation = start();
+    simulation.receive_packet(make_basic_login_packet(DimensionKind::new_raw(1), Identifier::new("azalea:a")));
+    simulation.tick();
+
+    // One tick holds all three packets, in this order: an overworld chunk, the move to the
+    // nether, a nether chunk.
+    simulation.receive_packet(make_basic_empty_chunk(ChunkPos::new(3, 3), OVERWORLD_SECTIONS));
+    simulation.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(2), Identifier::new("azalea:b")));
+    simulation.receive_packet(make_basic_empty_chunk(ChunkPos::new(4, 4), NETHER_SECTIONS));
+    simulation.tick();
+
+    assert!(simulation.chunk(ChunkPos::new(4, 4)).is_some(), "the nether chunk sent after the respawn is kept");
+    assert!(simulation.chunk(ChunkPos::new(3, 3)).is_none(), "the overworld chunk belongs to the old level");
+}
+
+#[test]
+fn nether_chunk_queued_before_a_respawn_to_the_overworld_is_not_decoded_into_it() {
+    let _lock = init();
+    let mut simulation = start();
+    simulation.receive_packet(make_basic_login_packet(DimensionKind::new_raw(2), Identifier::new("azalea:b")));
+    simulation.tick();
+
+    simulation.receive_packet(make_basic_empty_chunk(ChunkPos::new(3, 3), NETHER_SECTIONS));
+    simulation.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(1), Identifier::new("azalea:a")));
+    simulation.receive_packet(make_basic_empty_chunk(ChunkPos::new(4, 4), OVERWORLD_SECTIONS));
+    simulation.tick();
+
+    assert!(simulation.chunk(ChunkPos::new(4, 4)).is_some());
+    assert!(simulation.chunk(ChunkPos::new(3, 3)).is_none(), "a nether chunk must not appear in the overworld");
+}
