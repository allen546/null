From a67385938eb896f5a1a8d34e0209958e80e95031 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 15 Nov 2026 18:14:10 +0800
Subject: [PATCH] null patch: 77-keep-level-on-same-dimension-respawn

ClientPacketListener#handleRespawn builds a new level only when the dimension changes. The same dimension keeps the level, its chunks and entities, so the fork keeps the bot's partial world and loaded-by marks then. Restores the same-dimension Stone assertion weakened in patch 76 and adds a chunk test.
---
 azalea-client/src/plugins/packet/game/mod.rs  | 35 +++++++++++--------
 .../simulation/own_chunks_decide_loaded.rs    |  9 ++---
 .../simulation/shared_world_prediction.rs     | 31 +++++++++++++---
 3 files changed, 52 insertions(+), 23 deletions(-)

diff --git a/azalea-client/src/plugins/packet/game/mod.rs b/azalea-client/src/plugins/packet/game/mod.rs
index 7c630cc..9b4032d 100644
--- a/azalea-client/src/plugins/packet/game/mod.rs
+++ b/azalea-client/src/plugins/packet/game/mod.rs
@@ -1600,10 +1600,11 @@ impl GamePacketHandler<'_> {
                 let old_attributes = old_attributes.cloned();
 
                 let new_world_name = WorldName::for_bot(p.common.dimension.clone(), self.player);
+                let same_dimension = world_name.as_deref() == Some(&new_world_name);
                 // Patch 32, `handleRespawn`: a respawn in the same dimension adds the new local
                 // player to the same level, so it moves to the end of the tick order; another
                 // dimension builds a new level with an empty list, so the player is first again.
-                if world_name.as_deref() == Some(&new_world_name) {
+                if same_dimension {
                     entity_id_index.tick_order_mut().assign(self.player);
                 } else {
                     entity_id_index.tick_order_mut().clear();
@@ -1639,21 +1640,25 @@ impl GamePacketHandler<'_> {
                     });
                 }
 
-                // set the partial world to an empty world (when we add chunks or entities,
-                // those will be in the `worlds`)
-
-                *world_holder.partial.write() = PartialWorld::new(
-                    azalea_world::chunk::calculate_chunk_storage_range(
-                        client_information.view_distance.into(),
-                    ),
-                    Some(self.player),
-                );
-                world_holder.shared = weak_world;
-
-                // every entity is now unloaded by this player
-                for mut loaded_by in &mut loaded_by_query.iter_mut() {
-                    loaded_by.remove(&self.player);
+                // `handleRespawn` builds a new `ClientLevel` only when the dimension changes. The
+                // same dimension keeps the level, its chunks and its entities, so the bot keeps
+                // its partial world (the only strong chunk references) and its loaded entities.
+                // Another dimension starts empty (when we add chunks or entities, those will be
+                // in the `worlds`).
+                // Spec: specs/B6-placement-breaking.md §4.10
+                if !same_dimension {
+                    *world_holder.partial.write() = PartialWorld::new(
+                        azalea_world::chunk::calculate_chunk_storage_range(
+                            client_information.view_distance.into(),
+                        ),
+                        Some(self.player),
+                    );
+                    // every entity is now unloaded by this player
+                    for mut loaded_by in &mut loaded_by_query.iter_mut() {
+                        loaded_by.remove(&self.player);
+                    }
                 }
+                world_holder.shared = weak_world;
 
                 // this resets a bunch of our components like physics and stuff
                 #[allow(unused_mut)]
diff --git a/azalea-client/tests/simulation/own_chunks_decide_loaded.rs b/azalea-client/tests/simulation/own_chunks_decide_loaded.rs
index 72258dd..0923ee4 100644
--- a/azalea-client/tests/simulation/own_chunks_decide_loaded.rs
+++ b/azalea-client/tests/simulation/own_chunks_decide_loaded.rs
@@ -6,9 +6,10 @@ use azalea_registry::{DataRegistry, data::DimensionKind, identifier::Identifier}
 
 // Spec: specs/F5-version-layer.md §4.6 (What Null computes). `LevelLoadStatusManager#tick`: a client
 // is loaded when the chunk it stands in is in its own level. After a respawn the bot's own chunks are
-// empty; a chunk another bot of the swarm still holds (the shared `World` keeps it) must not count.
+// empty (another dimension builds a new level; the same dimension keeps its chunks, patch 77); a chunk
+// another bot of the swarm still holds in the old level must not count.
 #[test]
-fn a_respawned_bot_waits_for_its_own_chunk_even_if_another_bot_holds_it() {
+fn a_bot_respawned_into_another_dimension_waits_for_its_own_chunk_even_if_another_bot_holds_it() {
     let _lock = init();
     let mut simulation = Simulation::new(ConnectionProtocol::Game);
     simulation.receive_packet(default_login_packet());
@@ -24,12 +25,12 @@ fn a_respawned_bot_waits_for_its_own_chunk_even_if_another_bot_holds_it() {
 
     simulation.receive_packet(make_basic_respawn_packet(
         DimensionKind::new_raw(0),
-        Identifier::new("minecraft:overworld"),
+        Identifier::new("azalea:other"),
     ));
     for _ in 0..5 {
         simulation.tick();
     }
-    assert!(simulation.chunk(ChunkPos::new(0, 0)).is_some(), "the shared storage still has the chunk");
+    assert!(simulation.chunk(ChunkPos::new(0, 0)).is_none(), "the new level has no chunk yet");
     assert!(
         !simulation.has_component::<HasClientLoaded>(),
         "the bot's own chunks are empty after the respawn, so it is not loaded yet"
diff --git a/azalea-client/tests/simulation/shared_world_prediction.rs b/azalea-client/tests/simulation/shared_world_prediction.rs
index 0a5dce9..b0e7849 100644
--- a/azalea-client/tests/simulation/shared_world_prediction.rs
+++ b/azalea-client/tests/simulation/shared_world_prediction.rs
@@ -258,7 +258,7 @@ fn test_a_resent_chunk_beats_the_pending_prediction() {
 // Edge case b: a chunk this bot forgets. EXPECTED: its pending cell is not read again, even if
 // the chunk comes back (the level holds no block for a chunk the bot lost).
 #[test]
-fn test_a_forgotten_chunk_does_not_come_back_through_the_overlay() {
+fn test_a_forgotten_chunk_does_not_come_back_through_the_prediction() {
     let _lock = init();
     let mut s = single_bot_over_air();
     let a = s.entity;
@@ -293,13 +293,36 @@ fn test_a_dimension_change_clears_the_pending_cells_and_a_same_dimension_respawn
     s.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(0), Identifier::new("minecraft:overworld")));
     s.tick();
     assert_eq!(s.component::<BlockStatePredictionHandler>().seq(), 1, "same dimension: the level and its handler stay");
-    // the cell stays pending. (The respawn handler still drops the bot's chunks in the same
-    // dimension, so the level no longer shows the prediction: OPEN §4 parity gaps.)
+    // the cell stays pending and the level, with its chunk, still shows the prediction
     assert!(s.component::<BlockStatePredictionHandler>().is_pending(floor));
-    let _ = a;
+    assert_eq!(view(&s, a, floor), Some(BlockKind::Stone.into()), "same dimension: the level keeps the predicted block");
     s.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(0), Identifier::new("azalea:other")));
     s.tick();
     let h = s.component::<BlockStatePredictionHandler>();
     assert_eq!(h.seq(), 0, "another dimension: a new handler, the sequence restarts");
     assert!(!h.is_pending(floor), "the pending cells are gone");
 }
+
+// `ClientPacketListener#handleRespawn`: the same dimension keeps the level and its chunks; another
+// dimension builds a new level with no chunks (the server sends them again).
+// Spec: specs/B6-placement-breaking.md §4.10
+#[test]
+fn test_chunks_stay_after_a_same_dimension_respawn_and_are_replaced_after_a_dimension_change() {
+    let _lock = init();
+    let mut s = single_bot_over_air();
+    let a = s.entity;
+    for _ in 0..3 {
+        s.tick();
+    }
+    let floor = BlockPos::new(3, 63, 3);
+    assert_eq!(view(&s, a, floor), Some(BlockState::AIR), "the chunk is loaded");
+    s.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(0), Identifier::new("minecraft:overworld")));
+    s.tick();
+    assert_eq!(view(&s, a, floor), Some(BlockState::AIR), "same dimension: the chunk stays loaded");
+    s.receive_packet(make_basic_respawn_packet(DimensionKind::new_raw(0), Identifier::new("azalea:other")));
+    s.tick();
+    assert_eq!(view(&s, a, floor), None, "another dimension: a new level with no chunk");
+    s.receive_packet(make_basic_empty_chunk(ChunkPos::new(0, 0), (384 + 64) / 16));
+    s.tick();
+    assert_eq!(view(&s, a, floor), Some(BlockState::AIR), "the new level takes the resent chunk");
+}
