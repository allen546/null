+            (4, ItemKind::Sugar, 1), (5, ItemKind::Egg, 1), (6, ItemKind::Sugar, 1),
+            (7, ItemKind::Wheat, 1), (8, ItemKind::Wheat, 1), (9, ItemKind::Wheat, 1),
