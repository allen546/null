+        assert_eq!(inv.carried, ItemStack::new(ItemKind::Stick, 4));
+        assert_eq!(inv.menu().slot(5), Some(&ItemStack::new(ItemKind::OakPlanks, 1)));
+        assert_eq!(inv.menu().slot(8), Some(&ItemStack::new(ItemKind::OakPlanks, 1)));
+    }
