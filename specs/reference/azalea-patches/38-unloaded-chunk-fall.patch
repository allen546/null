From 4ee1f8a786d637efedd83aee8241cf696911b2e5 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Thu, 22 Oct 2026 13:49:02 +0800
Subject: [PATCH] null patch: 38-unloaded-chunk-fall

LivingEntity#travelInAir: with no chunk at the block below the feet the vertical speed is a fixed -0.1 above the world bottom and 0 at or below it, in place of gravity. Grim does not predict movement in an unloaded chunk (SetbackTeleportUtil#insideUnloadedChunk); a bot that fell normally drew Simulation alerts after a teleport into an unsent chunk.
---
 azalea-physics/src/travel.rs    | 16 ++++++++-
 azalea-physics/tests/physics.rs | 64 +++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 1 deletion(-)

diff --git a/azalea-physics/src/travel.rs b/azalea-physics/src/travel.rs
index 0fa0db8..0895445 100644
--- a/azalea-physics/src/travel.rs
+++ b/azalea-physics/src/travel.rs
@@ -1,7 +1,7 @@
 use azalea_block::{BlockState, fluid_state::FluidState};
 use azalea_core::{
     aabb::Aabb,
-    position::{BlockPos, Vec3},
+    position::{BlockPos, ChunkPos, Vec3},
 };
 use azalea_entity::{
     ActiveEffects, Attributes, HasClientLoaded, Jumping, LocalEntity, LookDirection, OnClimbable, Physics,
@@ -140,6 +140,9 @@ fn travel_in_air(ctx: &mut MoveCtx) {
 
     if let Some(amplifier) = ctx.levitation {
         movement.y = levitation_vertical_speed(movement.y, amplifier);
+    } else if ctx.world.chunks.get(&ChunkPos::from(block_pos_below)).is_none() {
+        // patch 38: the chunk under the feet has not arrived, so there is no gravity
+        movement.y = unloaded_chunk_vertical_speed(ctx.position.y, ctx.world.chunks.min_y());
     } else {
         // `getEffectiveGravity` reads the speed at this point, after the move step.
         movement.y -= effective_gravity(
@@ -387,6 +390,17 @@ pub fn effective_gravity(gravity: f64, velocity_y: f64, slow_falling: bool) -> f
     }
 }
 
+/// The vertical speed `LivingEntity#travelInAir` sets when the client has no chunk at the block
+/// below the feet (`Level#hasChunkAt` false): a fixed fall of 0.1 above the world bottom, none at
+/// or below it. It replaces the gravity step, so the player falls at a steady speed until the
+/// chunk arrives. Grim does not predict movement there (`SetbackTeleportUtil#insideUnloadedChunk`,
+/// used by `MovementCheckRunner`), so a bot that kept the normal fall drew `Simulation` alerts
+/// once the chunk came in.
+// Spec: specs/B1-movement.md §4.2
+pub fn unloaded_chunk_vertical_speed(y: f64, world_min_y: i32) -> f64 {
+    if y > world_min_y as f64 { -0.1 } else { 0.0 }
+}
+
 /// The vertical speed `LivingEntity#travelInAir` gives with Levitation of this amplifier (0 is
 /// level I) before the air drag: the old speed plus a fifth of the gap to 0.05 x (amplifier + 1).
 // Spec: specs/B1-movement.md §4.2
diff --git a/azalea-physics/tests/physics.rs b/azalea-physics/tests/physics.rs
index 0eae06f..06c0b47 100644
--- a/azalea-physics/tests/physics.rs
+++ b/azalea-physics/tests/physics.rs
@@ -946,3 +946,67 @@ mod levitation_slow_falling {
         assert!((levitation_vertical_speed(-1.0, 1) - (-1.0 + 1.1 * 0.2)).abs() < 1e-12);
     }
 }
+
+// Patch 38: `LivingEntity#travelInAir` with no chunk at the block below the feet.
+mod unloaded_chunk {
+    use bevy_ecs::entity::Entity;
+
+    use super::{block_effects::{setup, tick}, *};
+
+    const DRAG: f64 = 0.9800000190734863;
+
+    fn vy_after(x: f64, y: f64, ticks: usize) -> Vec<f64> {
+        let (mut app, e, _w) = setup(BlockKind::Stone, BlockKind::Air, false, false);
+        move_to(&mut app, e, x, y);
+        (0..ticks)
+            .map(|_| {
+                tick(&mut app, e, 0.);
+                app.world().get::<Physics>(e).unwrap().velocity.y
+            })
+            .collect()
+    }
+
+    fn move_to(app: &mut App, e: Entity, x: f64, y: f64) {
+        let mut p = app.world_mut().get_mut::<Position>(e).unwrap();
+        p.x = x;
+        p.y = y;
+    }
+
+    // No chunk (x = 1000 is chunk 62, never loaded): the fall is a steady -0.1 a tick, then drag.
+    #[test]
+    fn steady_fall_without_a_chunk() {
+        for v in vy_after(1000.5, 70., 6) {
+            assert!((v - -0.1 * DRAG).abs() < 1e-12, "{v}");
+        }
+    }
+
+    // At or below the world bottom (-64 in the overworld) the speed is 0.
+    #[test]
+    fn no_fall_below_the_world_bottom_without_a_chunk() {
+        for v in vy_after(1000.5, -64., 3) {
+            assert_eq!(v, 0.0);
+        }
+        for v in vy_after(1000.5, -70., 3) {
+            assert_eq!(v, 0.0);
+        }
+    }
+
+    // With the chunk loaded, the normal gravity step applies (control).
+    #[test]
+    fn gravity_with_a_chunk() {
+        let (mut app, e, _w) = setup(BlockKind::Air, BlockKind::Air, false, false);
+        move_to(&mut app, e, 0.5, 90.);
+        tick(&mut app, e, 0.);
+        let v = app.world().get::<Physics>(e).unwrap().velocity.y;
+        assert!((v - -0.08 * DRAG).abs() < 1e-12, "{v}");
+    }
+
+    #[test]
+    fn speed_formula() {
+        use azalea_physics::travel::unloaded_chunk_vertical_speed as f;
+        assert_eq!(f(70., -64), -0.1);
+        assert_eq!(f(-63.9, -64), -0.1);
+        assert_eq!(f(-64., -64), 0.0);
+        assert_eq!(f(-100., -64), 0.0);
+    }
+}
