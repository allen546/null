         for _ in 0..10 {
-            let block = self
-                .world()?
-                .read()
-                .get_block_state(pos)
-                .unwrap_or_default();
+            // the bot's own view, not shared truth (patch 59)
+            let block = self.own_block_state(pos)?.unwrap_or_default();
             if !block.is_collision_shape_empty() {
                 break;
             }
