     };
 
     let x_collision = movement.x != collided_delta.x;
     let y_collision = movement.y != collided_delta.y;
     let z_collision = movement.z != collided_delta.z;
+    let pushed_down_onto_ground = y_collision && movement.y < 0.;
 
