From: bench <bench@local>
Date: Wed, 21 Oct 2026 22:33:01 +0800
Subject: [PATCH] null patch: 35-pathfinder-interpolation-ambiguity

---
 azalea/src/pathfinder/execute/mod.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/azalea/src/pathfinder/execute/mod.rs b/azalea/src/pathfinder/execute/mod.rs
index c372a18..5893739 100644
--- a/azalea/src/pathfinder/execute/mod.rs
+++ b/azalea/src/pathfinder/execute/mod.rs
@@ -68,6 +68,8 @@ impl Plugin for DefaultPathfinderExecutionPlugin {
                 .after(azalea_client::movement::send_position)
                 .after(MiningSystems)
                 .after(debug_render_path_with_particles)
+                // Interpolation writes only entities `Without<LocalEntity>`; these read the bot's own.
+                .ambiguous_with(azalea_entity::interpolation::interpolate_entities)
                 .in_set(PathfinderSystems),
         );
     }
