+/// The wall block a torch item places on a side face (`StandingAndWallBlockItem`).
+pub fn torch_wall_block(kind: BlockKind) -> Option<BlockKind> {
+    match kind {
+        BlockKind::BrainCoralFan => Some(BlockKind::BrainCoralWallFan),
+        BlockKind::CopperTorch => Some(BlockKind::CopperWallTorch),
+        BlockKind::CreeperHead => Some(BlockKind::CreeperWallHead),
+        BlockKind::DragonHead => Some(BlockKind::DragonWallHead),
+        BlockKind::FireCoralFan => Some(BlockKind::FireCoralWallFan),
+        BlockKind::HornCoralFan => Some(BlockKind::HornCoralWallFan),
+        BlockKind::PiglinHead => Some(BlockKind::PiglinWallHead),
+        BlockKind::RedstoneTorch => Some(BlockKind::RedstoneWallTorch),
+        BlockKind::SkeletonSkull => Some(BlockKind::SkeletonWallSkull),
+        BlockKind::SoulTorch => Some(BlockKind::SoulWallTorch),
+        BlockKind::Torch => Some(BlockKind::WallTorch),
+        BlockKind::TubeCoralFan => Some(BlockKind::TubeCoralWallFan),
+        BlockKind::WitherSkeletonSkull => Some(BlockKind::WitherSkeletonWallSkull),
+        BlockKind::ZombieHead => Some(BlockKind::ZombieWallHead),
+        _ => None,
+    }
+}
